{
  "name": "spearcon-factory",
  "private": true,
  "version": "1.0.0",
  "description": "Batch spearcon generation in the browser, using the SOLAFS engine compiled to WebAssembly.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run check:wasm && vitest run",
    "typecheck": "tsc --noEmit",
    "build:wasm": "bash wasm/build.sh",
    "check:wasm": "node scripts/wasm-hash.mjs --check",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
